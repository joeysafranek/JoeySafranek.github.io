# Universally Unique Identifier (for bluetooth)
_SERVICE_UUID = bluetooth.UUID(0x1848)
_CHARACTERISTIC_UUID = bluetooth.UUID(0x2A6E)

# Diffrent variables for the text sent to your phone
waterDetected = "Water is Detected!"
waterNotDetected = "No water is Detected."

# Bluetooth parameters
BLE_NAME = f"State Farm Project" 
BLE_SVC_UUID = bluetooth.UUID("4d1502f8-181f-4e07-9ca6-3a5b70505056") #My water sensors UUID-- Change to a diffrent UUID
BLE_CHARACTERISTIC_UUID = bluetooth.UUID("701134e8-5f16-45b8-8b6a-e421157f998c") #My water sensors UUID-- Change to a diffrent UUID
BLE_APPEARANCE = 0x0300
BLE_ADVERTISING_INTERVAL = 2000
BLE_SCAN_LENGTH = 5000
BLE_INTERVAL = 30000
BLE_WINDOW = 30000

# Pins as variables for easy changes
redLedPin = 15
greenLedPin = 14
blueLedPin = 13
waterSensorPin = 28
